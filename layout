<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pure HTML/CSS Responsive Page Layout</title>
  <style>
    /* CSS Reset */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background-color: #f3f4f6;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }

    h2 {
      font-family: monospace;
      text-align: center;
      margin-bottom: 20px;
      font-size: 1.5rem;
    }

    /* Outer Wrapper / Container */
    .layout-container {
      width: 100%;
      max-width: 650px;
      border: 2px solid #000;
      background-color: #ffffff;
      padding: 8px;
    }

    /* The Main Grid */
    .grid-page {
      display: grid;
      /* 4 Columns: Left Gutter, Main Content, Sidebar, Right Gutter */
      grid-template-columns: 1fr 3fr 1.5fr 1fr;
      
      /* 7 Rows for all sections */
      grid-template-rows: 45px 90px 220px 40px 45px 30px;
      
      /* Visual layout mapping */
      grid-template-areas:
        "header    header    header   header"
        "gutter-l  masthead  masthead gutter-r"
        "gutter-l  main      sidebar  gutter-r"
        "prefooter prefooter prefooter prefooter"
        "footer    footer    footer   footer"
        "subfooter subfooter subfooter subfooter";
    }

    /* Common Box Style */
    .box {
      border: 1px solid #222222;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 0.95rem;
      text-transform: capitalize;
    }

    /* Area Placements and Color Matching */
    .header {
      grid-area: header;
      background-color: #55b7b1;
    }

    .gutter-left {
      grid-area: gutter-l;
      background-color: #d1d5db;
    }

    .gutter-right {
      grid-area: gutter-r;
      background-color: #d1d5db;
    }

    .masthead {
      grid-area: masthead;
      background-color: #fde047;
    }

    .main-content {
      grid-area: main;
      background-color: #4f6d9a;
      color: #ffffff;
    }

    .sidebar {
      grid-area: sidebar;
      background-color: #8fa0be;
    }

    .prefooter {
      grid-area: prefooter;
      background-color: #d97757;
      color: #ffffff;
    }

    .footer {
      grid-area: footer;
      background-color: #52a447;
      color: #ffffff;
    }

    .subfooter {
      grid-area: subfooter;
      background-color: #52a447;
      border-top: 1px solid rgba(0, 0, 0, 0.2);
      color: #ffffff;
      font-size: 0.8rem;
    }

    /* Vertical text rotation for gutter sidebars */
    .vertical-text {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }
  </style>
</head>
<body>

  <h2>
    Bootstrap<br>
    <u>responsive page layout</u>
  </h2>

  <!-- Page Layout Wrapper -->
  <div class="layout-container">
    <div class="grid-page">
      <div class="box header">Header</div>
      <div class="box gutter-left"><span class="vertical-text">Gutter</span></div>
      <div class="box masthead">Masthead</div>
      <div class="box main-content">Main Content</div>
      <div class="box sidebar">Sidebar</div>
      <div class="box gutter-right"><span class="vertical-text">Gutter</span></div>
      <div class="box prefooter">Pre-footer</div>
      <div class="box footer">Footer</div>
      <div class="box subfooter">Subfooter</div>
    </div>
  </div>

</body>
</html>







